{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@rotacerta/web", "dev"],
      "port": 5173
    },
    {
      "name": "web-alt",
      "runtimeExecutable": "pnpm",
