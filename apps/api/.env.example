# ---- Ambiente: ative exatamente UM (true) e deixe o outro false ----
AMBIENTE_TESTE=true
AMBIENTE_PRODUCAO=false

PORT=3333
# TESTE: vazio = banco embutido (PGlite, sem Docker), já com migração e dados de demonstração.
#        Ou use o Postgres do docker compose: postgres://rotacerta:rotacerta@localhost:5440/rotacerta
# PRODUÇÃO: obrigatório, Postgres real.
DATABASE_URL=
# mínimo 32 caracteres. TESTE: opcional. PRODUÇÃO: obrigatório (openssl rand -hex 32).
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_DAYS=14
# lax: web e API no mesmo site (localhost). none: domínios diferentes, exige HTTPS (COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
LOGIN_RATE_MAX=10
LOCATION_RETENTION_DAYS=30
CORS_ORIGIN=http://localhost:5173,http://localhost:5175
APP_TZ=America/Sao_Paulo
# Só no ambiente de teste (padrão: rotacerta123). Seed nunca roda em produção.
SEED_PASSWORD=

# Segurança e escala (opcionais; padrões no config.ts)
# TRUST_PROXY=true          # padrão: ligado em produção (API atrás de proxy)
# WRITE_RATE_MAX=300        # escritas por minuto e por IP
# LOGIN_LOCK_FAILURES=8     # falhas seguidas até bloquear a conta
# LOGIN_LOCK_MINUTES=15
# REDIS_URL=redis://localhost:6379   # tempo real entre várias instâncias

# Agentes de IA (opcional)
# ANTHROPIC_API_KEY=sk-ant-...      # sem a chave, os agentes ficam só para configuração
# AGENT_DAILY_LIMIT=300             # conversas com agentes por empresa e por dia
