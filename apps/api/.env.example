# Copie para .env (não versionado) e ajuste.
NODE_ENV=development
PORT=3333
DATABASE_URL=postgres://rotacerta:rotacerta@localhost:5432/rotacerta
# mínimo 32 caracteres; em produção, gere um valor aleatório e guarde no gerenciador de segredos
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32+
# token de acesso curto; a sessão longa vem do cookie de renovação
JWT_EXPIRES_IN=15m
REFRESH_DAYS=14
# lax: web e API no mesmo site (localhost). none: domínios diferentes, exige HTTPS (COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
LOGIN_RATE_MAX=10
CORS_ORIGIN=http://localhost:5173
APP_TZ=America/Sao_Paulo
# apenas desenvolvimento: senha dos usuários criados por `pnpm --filter @rotacerta/api db:seed`
SEED_PASSWORD=
